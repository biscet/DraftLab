index 0000000..0d7c724
--- /dev/null
+++ b/scripts/whittle_eagle3.py
@@ -0,0 +1,221 @@
+#!/usr/bin/env python3
+"""Stream qwen4exp GGUF teacher features into SpecForge offline checkpoints."""
+
+import argparse
+import fcntl
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+
+LAYERS = [2, 20, 37]
+LAYOUT = "native-attn-mix-v1"
+WIDTH = 2048
+VOCAB = 248320
+
+
+def identity(path):
+    path = path.resolve(strict=True)
+    st = path.stat()
+    return {"path": str(path), "size": st.st_size, "mtime_ns": st.st_mtime_ns}
+
+
+def write_json(path, value):
+    temporary = path.with_suffix(".tmp")
+    temporary.write_text(json.dumps(value, indent=2) + "\n")
+    temporary.replace(path)
+
+
+def verify_manifest(path, expected):
+    if path.exists():
+        if json.loads(path.read_text()) != expected:
+            raise ValueError(f"{path} describes a different model, dataset or capture configuration")
+    else:
+        write_json(path, expected)
+
+
+def capture_features(args):
+    import torch
+
+    if not 2 <= args.max_tokens <= 8192 or args.shard_size < 1:
+        raise ValueError("max-tokens must be between 2 and 8192 and shard-size must be positive")
+    output = args.output.resolve()
+    output.mkdir(parents=True, exist_ok=True)
+    with (output / ".capture.lock").open("a") as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        with args.exporter.open("rb") as binary, args.input.open("rb") as data:
+            manifest = {
+                "model": identity(args.model),
+                "data_sha256": hashlib.file_digest(data, "sha256").hexdigest(),
+                "exporter_sha256": hashlib.file_digest(binary, "sha256").hexdigest(),
+                "feature_layout": LAYOUT,
+                "layers": LAYERS,
+                "max_tokens": args.max_tokens,
+                "volta_small_attention": os.getenv("GGML_CUDA_FA_VOLTA_SMALL", "0"),
+                "shard_size": args.shard_size,
+                "width": WIDTH,
+            }
+        verify_manifest(output / "manifest.json", manifest)
+        with tempfile.TemporaryDirectory(dir=output, prefix=".pending-") as temporary:
+            pending = Path(temporary) / "input.jsonl"
+            count = 0
+            with args.input.open() as data, pending.open("w") as staged:
+                for index, line in enumerate(data):
+                    if args.limit and index >= args.limit:
+                        break
+                    shard = output / f"shard-{index // args.shard_size:06d}"
+                    destination = shard / f"{index:09d}.ckpt"
+                    if destination.is_file():
+                        continue
+                    row = json.loads(line)
+                    ids = row["input_ids"]
+                    if "loss_mask" in row:
+                        mask = row["loss_mask"]
+                    else:
+                        prompt_n = row["prompt_n"]
+                        if not 1 <= prompt_n < len(ids):
+                            raise ValueError(f"Invalid prompt_n at row {index}")
+                        mask = [0] * prompt_n + [1] * (len(ids) - prompt_n)
+                    if len(ids) != len(mask) or any(value not in (0, 1) for value in mask):
+                        raise ValueError(f"Invalid loss_mask at row {index}")
+                    ids, mask = ids[: args.max_tokens], mask[: args.max_tokens]
+                    if len(ids) < 3 or not any(mask[1:-1]):
+                        continue
+                    staged.write(json.dumps({"input_ids": ids, "loss_mask": mask, "index": index}) + "\n")
+                    count += 1
+            if not count:
+                print("No pending samples")
+                return
+            print(f"Capturing {count} samples", flush=True)
+            capture_pending(args, pending, output, torch)
+
+
+def capture_pending(args, pending, output, torch):
+    command = [str(args.exporter.resolve()), str(args.model.resolve()), str(pending), str(args.max_tokens)]
+    with subprocess.Popen(command, stdout=subprocess.PIPE) as exporter:
+        try:
+            with pending.open() as staged:
+                for line in staged:
+                    row = json.loads(line)
+                    index = row["index"]
+                    ids = row["input_ids"]
+                    byte_count = len(ids) * 4 * WIDTH * 2
+                    raw = bytearray(exporter.stdout.read(byte_count))
+                    if len(raw) != byte_count:
+                        raise RuntimeError(f"Teacher stream stopped during sample {index}")
+                    states = torch.frombuffer(raw, dtype=torch.float16).reshape(len(ids), 4, WIDTH)
+                    sample = {
+                        "input_ids": torch.tensor(ids, dtype=torch.long),
+                        "loss_mask": torch.tensor(row["loss_mask"], dtype=torch.long),
+                        "aux_hidden_state": states[:, :3].reshape(1, len(ids), 3 * WIDTH).contiguous(),
+                        "hidden_state": states[:, 3].unsqueeze(0).contiguous(),
+                    }
+                    shard = output / f"shard-{index // args.shard_size:06d}"
+                    shard.mkdir(exist_ok=True)
+                    target = shard / f"{index:09d}.ckpt"
+                    temporary = target.with_suffix(".tmp")
+                    try:
+                        with temporary.open("wb") as file:
+                            torch.save(sample, file)
+                            file.flush()
+                            os.fsync(file.fileno())
+                        temporary.replace(target)
+                    finally:
+                        temporary.unlink(missing_ok=True)
+                    print(f"Saved {target.name} ({len(ids)} tokens)", flush=True)
+            if exporter.stdout.read(1) or exporter.wait() != 0:
+                raise RuntimeError("Teacher exporter did not finish cleanly")
+        except BaseException:
+            exporter.terminate()
+            raise
+
+
+def prepare_target(args):
+    import numpy as np
+    from gguf import GGUFReader, dequantize
+    from safetensors.numpy import save_file
+
+    config = json.loads((args.target / "config.json").read_text())
+    config = config.get("text_config", config)
+    if (config["hidden_size"], config["vocab_size"], config["num_hidden_layers"]) != (WIDTH, VOCAB, 40):
+        raise ValueError("Expected the published Whittle text configuration")
+    model = GGUFReader(args.model)
+    architecture = model.fields["general.architecture"].contents()
+    if architecture != "qwen4exp":
+        raise ValueError("Expected a qwen4exp GGUF")
+
+    weights = {
+        "model.embed_tokens.weight": "token_embd.weight",
+        "lm_head.weight": "output.weight",
+    }
+    manifest = {"model": identity(args.model), "dtype": "float16", "tensors": weights}
+    index = args.target / "model.safetensors.index.json"
+    with (args.target / ".weights.lock").open("a") as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        verify_manifest(args.target / "source_gguf.json", manifest)
+        if index.exists():
+            return
+        tensors = {tensor.name: tensor for tensor in model.tensors if tensor.name in weights.values()}
+        weight_map = {}
+        for i, (key, name) in enumerate(weights.items(), 1):
+            source = tensors[name]
+            if tuple(source.shape) != (WIDTH, VOCAB):
+                raise ValueError(f"Unexpected {name} shape {source.shape}")
+            filename = f"model-{i:05d}-of-00002.safetensors"
+            final = args.target / filename
+            if not final.exists():
+                table = np.empty((VOCAB, WIDTH), dtype=np.float16)
+                for offset in range(0, VOCAB, 4096):
+                    rows = source.data[offset : offset + 4096]
+                    table[offset : offset + len(rows)] = dequantize(rows, source.tensor_type)
+                temporary = final.with_suffix(".tmp")
+                try:
+                    save_file({key: table}, temporary)
+                    temporary.replace(final)
+                finally:
+                    temporary.unlink(missing_ok=True)
+                del table
+            weight_map[key] = filename
+        write_json(index, {"metadata": {"total_size": 2 * 2 * WIDTH * VOCAB}, "weight_map": weight_map})
+
+
+def tag_export(args):
+    path = args.draft / "config.json"
+    config = json.loads(path.read_text())
+    layer_ids = config.get("eagle_config", {}).get("eagle_aux_hidden_state_layer_ids")
+    if layer_ids != LAYERS or config.get("target_hidden_size") != WIDTH:
+        raise ValueError("The serving checkpoint does not match the Whittle capture layout")
+    config["qwen4exp_feature_layout"] = LAYOUT
+    config["eagle_aux_hidden_state_layer_ids"] = layer_ids
+    write_json(path, config)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    commands = parser.add_subparsers(dest="command", required=True)
+    capture = commands.add_parser("capture")
+    capture.add_argument("--model", required=True, type=Path)
+    capture.add_argument("--exporter", required=True, type=Path)
+    capture.add_argument("--input", required=True, type=Path)
+    capture.add_argument("--output", required=True, type=Path)
+    capture.add_argument("--max-tokens", default=1024, type=int)
+    capture.add_argument("--shard-size", default=256, type=int)
+    capture.add_argument("--limit", type=int)
+    capture.set_defaults(run=capture_features)
+
+    target = commands.add_parser("prepare-target")
+    target.add_argument("--model", required=True, type=Path)
+    target.add_argument("--target", required=True, type=Path)
+    target.set_defaults(run=prepare_target)
+
+    tag = commands.add_parser("tag-export")
+    tag.add_argument("--draft", required=True, type=Path)
+    tag.set_defaults(run=tag_export)
+    args = parser.parse_args()
+    args.run(args)
+
+
+if __name__ == "__main__":
+    main()
