diff --git a/tools/whittle-eagle3/capture.cpp b/tools/whittle-eagle3/capture.cpp
new file mode 100644
index 0000000..0a6a9d6
--- /dev/null
+++ b/tools/whittle-eagle3/capture.cpp
@@ -0,0 +1,141 @@
+#include "common.h"
+#include "ggml-backend.h"
+#include "llama-ext.h"
+#include "llama.h"
+#include "nlohmann/json.hpp"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdio>
+#include <fstream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+using json = nlohmann::json;
+
+static void capture(const char * model_path, const char * input_path, uint32_t context) {
+    constexpr std::array<int, 4> layers = {2, 20, 37, 40};
+    constexpr int width = 2048;
+    constexpr int batch_size = 128;
+    constexpr int micro_batch = 64;
+
+    llama_log_set([](enum ggml_log_level level, const char * message, void *) {
+        if (level != GGML_LOG_LEVEL_DEBUG) {
+            std::fputs(message, stderr);
+        }
+    }, nullptr);
+    ggml_backend_load_all();
+    auto * gpu = ggml_backend_dev_by_name("CUDA0");
+    if (!gpu || ggml_backend_dev_by_name("CUDA1")) {
+        throw std::runtime_error("Expose exactly one CUDA GPU using CUDA_VISIBLE_DEVICES");
+    }
+
+    ggml_backend_dev_t devices[] = {gpu, nullptr};
+    const llama_model_tensor_buft_override overrides[] = {
+        {".*", ggml_backend_dev_buffer_type(gpu)},
+        {nullptr, nullptr},
+    };
+    auto mp = llama_model_default_params();
+    mp.devices = devices;
+    mp.tensor_buft_overrides = overrides;
+    mp.n_gpu_layers = -1;
+    mp.split_mode = LLAMA_SPLIT_MODE_NONE;
+    mp.lazy_mode = LLAMA_LAZY_MODE_OFF;
+    mp.no_host = true;
+    llama_model_ptr model(llama_model_load_from_file(model_path, mp));
+    char streams[16] = {};
+    if (!model || llama_model_n_layer(model.get()) != layers.back() || llama_model_n_embd(model.get()) != width ||
+            llama_model_meta_val_str(model.get(), "qwen4exp.hyper_connection.count", streams, sizeof(streams)) < 0 ||
+            std::string(streams) != "4") {
+        throw std::runtime_error("Expected the 40-block, four-stream Whittle GGUF");
+    }
+
+    auto cp = llama_context_default_params();
+    cp.n_ctx = context;
+    cp.n_batch = batch_size;
+    cp.n_ubatch = micro_batch;
+    cp.n_threads = 4;
+    cp.n_threads_batch = 4;
+    cp.flash_attn_type = LLAMA_FLASH_ATTN_TYPE_ENABLED;
+    cp.type_k = GGML_TYPE_F16;
+    cp.type_v = GGML_TYPE_F16;
+    cp.pooling_type = LLAMA_POOLING_TYPE_NONE;
+    llama_context_ptr ctx(llama_init_from_model(model.get(), cp));
+    if (!ctx || !llama_set_qwen4exp_eagle3_features(ctx.get())) {
+        throw std::runtime_error("Could not initialize qwen4exp teacher capture");
+    }
+    for (const auto & [buft, bytes] : llama_get_memory_breakdown(ctx.get())) {
+        if (bytes.model != 0 && buft != ggml_backend_dev_buffer_type(gpu)) {
+            throw std::runtime_error(std::string("Teacher weights allocated outside CUDA0: ") + ggml_backend_buft_name(buft));
+        }
+    }
+    for (int layer : layers) {
+        llama_set_embeddings_layer_inp(ctx.get(), layer, true);
+    }
+
+    std::ifstream input(input_path);
+    if (!input) {
+        throw std::runtime_error("Could not open input");
+    }
+    common_batch batch(ctx.get());
+    const llama_vocab * vocab = llama_model_get_vocab(model.get());
+    std::vector<ggml_fp16_t> features(batch_size * layers.size() * width);
+    for (std::string line; std::getline(input, line);) {
+        const auto ids = json::parse(line).at("input_ids").get<std::vector<llama_token>>();
+        if (ids.empty() || ids.size() > context ||
+                std::any_of(ids.begin(), ids.end(), [&](llama_token token) {
+                    return token < 0 || token >= llama_vocab_n_tokens(vocab);
+                })) {
+            throw std::runtime_error("Input has invalid token IDs or length");
+        }
+        llama_memory_clear(llama_get_memory(ctx.get()), true);
+        for (size_t offset = 0; offset < ids.size(); offset += batch_size) {
+            const int count = std::min<size_t>(batch_size, ids.size() - offset);
+            batch.clear();
+            for (int row = 0; row < count; ++row) {
+                batch.add(ids[offset + row], offset + row, 0, row == count - 1);
+            }
+            if (llama_process(ctx.get(), LLAMA_PROCESS_TYPE_DECODE, batch.get()) != 0) {
+                throw std::runtime_error("Teacher decode failed");
+            }
+            llama_synchronize(ctx.get());
+            for (size_t k = 0; k < layers.size(); ++k) {
+                const float * hidden = llama_get_embeddings_layer_inp(ctx.get(), layers[k]);
+                if (!hidden) {
+                    throw std::runtime_error("Missing teacher feature tensor");
+                }
+                for (int row = 0; row < count; ++row) {
+                    const float * src = hidden + row * width;
+                    if (std::any_of(src, src + width, [](float v) { return !std::isfinite(v) || std::abs(v) > 65504.0f; })) {
+                        throw std::runtime_error("Teacher feature cannot be represented in FP16");
+                    }
+                    auto * dst = features.data() + (row * layers.size() + k) * width;
+                    ggml_fp32_to_fp16_row(src, dst, width);
+                }
+            }
+            const size_t elements = count * layers.size() * width;
+            if (std::fwrite(features.data(), sizeof(ggml_fp16_t), elements, stdout) != elements || std::fflush(stdout) != 0) {
+                throw std::runtime_error("Could not stream teacher features");
+            }
+        }
+    }
+}
+
+int main(int argc, char ** argv) {
+    if (argc != 4) {
+        std::fprintf(stderr, "usage: %s MODEL.gguf INPUT.jsonl MAX_TOKENS\n", argv[0]);
+        return 1;
+    }
+    try {
+        const auto limit = std::stoul(argv[3]);
+        if (limit < 2 || limit > 8192) {
+            throw std::runtime_error("MAX_TOKENS must be in [2, 8192]");
+        }
+        capture(argv[1], argv[2], limit);
+    } catch (const std::exception & e) {
+        std::fprintf(stderr, "capture: %s\n", e.what());
+        return 1;
+    }
+}
